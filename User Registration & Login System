while True:
    username = input("Please create your username: ")
    length = len(username)
    if length >= 5:
        break
    else:
        print("Username must be atleast 5 characters long❌")
while True:    
    password = input("Create your password: ")
    length = len(password)
    score = 0
    if length >= 8:
        score = score + 1
    else:
        print("Issue: Password is too short❌")
        print("Try again🔄")
        continue 
        
    has_number = False
    
    for letter in password:
        if letter >= "0" and letter <= "9":
            score = score + 1
            has_number = True
            break
            
    if not has_number:
        print("Issue: Password must contain a number❌")
        print("Try again🔄")
        continue 
    
    has_uppercase = False
    
    for letter in password:
        if letter.isupper():
            score = score + 1
            has_uppercase = True
            break
    if not has_uppercase:
        print("Issue: Password must contain an uppercase letter❌")
        print("Try again🔄")
        continue 
        
    has_symbols = False
    special_symbols = "@#$_&-+()/*:;!?~`|•√π÷×§∆£¢€¥^°=\™✓"
    
    for letter in password:
        if letter in special_symbols:
            score = score + 1
            has_symbols = True
            break
    if not has_symbols:
        print("Issue: Password must contain a special symbol❌")
        print("Try again🔄")
        continue 
     
    if score == 4:
        print("Registration successful!✅")    
        break
        
